{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future-skills-evidence-graph.org/schemas/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": [
    "id",
    "statement",
    "source_ids",
    "text_anchor",
    "context",
    "age_range",
    "outcome",
    "evidence_type",
    "evidence_strength",
    "supports_skill_ids",
    "status",
    "created_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
    "statement": { "type": "string", "minLength": 8 },
    "source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "text_anchor": { "type": "string" },
    "context": { "type": "string" },
    "age_range": { "type": "string" },
    "outcome": { "type": "string" },
    "evidence_type": {
      "type": "string",
      "enum": [
        "framework_synthesis",
        "policy_synthesis",
        "empirical_study",
        "systematic_review",
        "conceptual_review",
        "labor_market_forecast",
        "expert_consensus"
      ]
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "moderate", "strong"]
    },
    "supports_skill_ids": { "type": "array", "items": { "type": "string" } },
    "contradicts_skill_ids": { "type": "array", "items": { "type": "string" } },
    "extraction_method": { "type": "string" },
    "status": { "type": "string", "enum": ["candidate", "reviewed", "rejected"] },
    "created_at": { "type": "string" },
    "reviewed_at": { "type": ["string", "null"] },
    "assist": {
      "type": "object",
      "description": "Optional, opt-in AI assist annotations. Never required; ignored by validate_data.py and score_evidence.py.",
      "properties": {
        "suggestions": { "type": "array", "items": { "type": "object" } },
        "provenance": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "prompt_version": { "type": "string" },
            "created_at": { "type": "string" }
          },
          "additionalProperties": true
        },
        "skill_links": {
          "type": "object",
          "description": "Non-binding skill-link suggestion from a separately versioned call. Advisory only: the real supports_skill_ids/contradicts_skill_ids stay empty until a reviewer passes --supports/--contradicts.",
          "properties": {
            "supports_skill_ids": { "type": "array", "items": { "type": "string" } },
            "contradicts_skill_ids": { "type": "array", "items": { "type": "string" } },
            "provenance": {
              "type": "object",
              "properties": {
                "model": { "type": "string" },
                "prompt_version": { "type": "string" },
                "created_at": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

